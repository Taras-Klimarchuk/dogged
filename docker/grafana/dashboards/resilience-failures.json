    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "timeout: our deadline fired. network: no HTTP response (refused, reset, DNS). app: the dependency answered with an error. Counted per attempt, so one request with 3 retries can add 3. client: the dependency rejected the request with a 4xx (not retried, not counted by the breaker).",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, kind) (rate(resilience_failures_total[1m]))",
          "legendFormat": "{{job}}: {{kind}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Failed attempts by cause (per second)",
      "type": "timeseries"
