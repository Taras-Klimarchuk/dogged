          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_request_duration_seconds_sum{job=\"terminal\",route=\"/orders\",method=\"POST\"}[1m])) / sum(rate(http_request_duration_seconds_count{job=\"terminal\",route=\"/orders\",method=\"POST\"}[1m])) and on() (circuit_breaker_state{job=\"terminal\",policy=\"orders-management-order\"} == 0)",
          "legendFormat": "avg",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Average response time, breaker closed",
      "type": "timeseries"
    },
