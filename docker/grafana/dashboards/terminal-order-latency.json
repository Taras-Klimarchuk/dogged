      },
      "description": "POST /orders on the terminal; the line disappears while the breaker is open or half-open, so fast rejections do not pull the average down.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
