{
  "name": "dogged",
  "version": "0.0.1",
  "description": "Resilient multi-service NestJS system built on a hot dog vendor domain: retries, circuit breakers, idempotency and fallbacks",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build:terminal": "nest build terminal",
    "build:orders-management": "nest build orders-management",
    "build:warehouse": "nest build warehouse",
    "build:all": "npm run build:terminal && npm run build:orders-management && npm run build:warehouse",
    "start:terminal": "nest start terminal",
    "start:terminal:dev": "nest start terminal --watch",
    "start:orders-management": "nest start orders-management",
    "start:orders-management:dev": "nest start orders-management --watch",
    "start:warehouse": "nest start warehouse",
    "start:warehouse:dev": "nest start warehouse --watch",
    "lint": "oxlint --type-aware apps/ libs/",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "migration:generate:orders-management": "typeorm-ts-node-esm migration:generate -d apps/orders-management/src/data-source.ts",
    "migration:run:orders-management": "typeorm-ts-node-esm migration:run -d apps/orders-management/src/data-source.ts",
    "migration:revert:orders-management": "typeorm-ts-node-esm migration:revert -d apps/orders-management/src/data-source.ts",
    "migration:generate:warehouse": "typeorm-ts-node-esm migration:generate -d apps/warehouse/src/data-source.ts",
    "migration:run:warehouse": "typeorm-ts-node-esm migration:run -d apps/warehouse/src/data-source.ts",
    "migration:revert:warehouse": "typeorm-ts-node-esm migration:revert -d apps/warehouse/src/data-source.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cockatiel": "^4.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@rspack/core": "^2.2.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.3",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3",
    "webpack-node-externals": "^3.0.0"
  }
}
