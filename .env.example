# Shared Postgres connection (one instance, separate databases per service)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

ORDERS_DB_NAME=orders_management
WAREHOUSE_DB_NAME=warehouse

# Identifies this terminal instance to orders-management. For a fixed set of
# terminals, each terminal service in docker-compose should set its own value.
TERMINAL_ID=terminal-a

# The full set of terminal ids orders-management should know about — it seeds
# TerminalStock for each of these (see SeedTerminalStock migration). Every
# terminal's own TERMINAL_ID above must be one of these values.
KNOWN_TERMINAL_IDS=terminal-a,terminal-b,terminal-c

# Per-service HTTP ports
TERMINAL_PORT=3000
ORDERS_MANAGEMENT_PORT=3001
WAREHOUSE_PORT=3002

# Service-to-service URLs (used by terminal -> orders-management, orders-management -> warehouse)
ORDERS_MANAGEMENT_URL=http://orders-management:3001
WAREHOUSE_URL=http://warehouse:3002

# terminal's local menu cache (stands in for localStorage/IndexedDB)
MENU_CACHE_DB_PATH=./data/menu-cache.sqlite3

# Alertmanager -> Telegram. Create a bot with @BotFather for the token; write to the bot
# once, then open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
